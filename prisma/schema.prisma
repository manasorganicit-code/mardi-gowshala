generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums

enum DonationPurpose {
  GENERAL
  FEED
  SPECIAL_OCCASION
  MEMORIAL
  MAINTENANCE
  OTHER
}

enum DonationType {
  ONE_TIME
  RECURRING
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  EXPIRED
}

enum MandateFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum MandateStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELLED
}

enum ContactSubject {
  GENERAL_QUERY
  VISIT
  GHEE_ORDER
  RECEIPT_REQUEST
  OTHER
}

// Models

model Donation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donorName String
  email     String
  phone     String
  ipAddress String?

  amount Decimal @db.Decimal(10, 2)

  purpose DonationPurpose @default(GENERAL)
  type    DonationType    @default(ONE_TIME)
  status  DonationStatus  @default(PENDING)

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  mandateId String?
  mandate   RecurringMandate? @relation(fields: [mandateId], references: [id])

  @@index([email])
  @@index([status])
  @@index([mandateId])
}

model RecurringMandate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  razorpaySubscriptionId String @unique

  donorName String
  email     String
  phone     String

  purpose   DonationPurpose  @default(GENERAL)
  frequency MandateFrequency
  status    MandateStatus    @default(PENDING)

  donations Donation[]

  @@index([email])
  @@index([status])
}

model ContactRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  name  String
  email String
  phone String

  subject ContactSubject

  address      String?
  gheeQuantity Int?

  message String

  @@index([subject])
}